<Window
    x:Class="TTIT.HelpWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:gif="http://wpfanimatedgif.codeplex.com"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Help"
    Width="396"
    Height="315"
    ResizeMode="NoResize"
    WindowStyle="None">
    <Grid Background="#363636" MouseDown="Window_MouseDown">
        <ui:TitleBar
            Height="30"
            Panel.ZIndex="2"
            CanMaximize="False"
            ShowClose="True"
            ShowHelp="False"
            ShowMaximize="False"
            ShowMinimize="False" />
        <Image Panel.ZIndex="1" gif:ImageBehavior.AnimatedSource="Assets/lindi.gif" />
    </Grid>
</Window>