<Window
    x:Class="TTIT.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Twilight Tuck-In Timer"
    Width="400"
    Height="Auto"
    MinWidth="400"
    d:DesignHeight="200"
    d:DesignWidth="400"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d">

    <Grid Background="#363636">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Twilight Tuck-In Timer"
            Grid.Row="0"
            Height="auto"
            Padding="8,4,8,4"
            ApplicationTheme="Dark"
            Background="#2b2b2b"
            CanMaximize="false"
            HelpClicked="TitleBar_HelpClicked"
            ShowClose="True"
            ShowHelp="True"
            ShowMaximize="False"
            ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon
                    Width="16"
                    Height="16"
                    Source="pack://application:,,,/Assets/moon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:NumberBox
                x:Name="HoursBox"
                Grid.Row="0"
                Grid.Column="0"
                Width="180"
                HorizontalAlignment="Center"
                MaxLength="5"
                Minimum="0"
                PlaceholderText="Hours" />
            <ui:NumberBox
                x:Name="MinutesBox"
                Grid.Row="0"
                Grid.Column="1"
                Width="180"
                HorizontalAlignment="Center"
                MaxLength="5"
                Minimum="0"
                PlaceholderText="Minutes" />

            <Separator
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="0,5" />

            <ui:Button
                Grid.Row="2"
                Grid.Column="0"
                Width="180"
                HorizontalAlignment="Center"
                Background="DarkOliveGreen"
                Click="OnScheduleShutdownClick">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Clock24" />
                    <Label Margin="5,4,0,0">Schedule Shutdown</Label>
                </StackPanel>
            </ui:Button>

            <ui:Button
                Grid.Row="2"
                Grid.Column="1"
                Width="180"
                HorizontalAlignment="Center"
                Background="DarkRed"
                Click="CancelShutdownButton_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Dismiss24" />
                    <Label Margin="5,4,0,0">Cancel Shutdown</Label>
                </StackPanel>
            </ui:Button>
        </Grid>
    </Grid>
</Window>